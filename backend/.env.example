PROJECT_NAME=فروشگاه شاکار
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRST_SUPERUSER_EMAIL=admin@shakar.ir
FIRST_SUPERUSER_PASSWORD=Admin@123456
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Local development default: SQLite for zero-setup startup on Windows/macOS/Linux
# For PostgreSQL, replace with something like:
# DATABASE_URL=postgresql+asyncpg://shakar:shakar@localhost:5432/shakar_db
DATABASE_URL=sqlite+aiosqlite:///./shakar.db
